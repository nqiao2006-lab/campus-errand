/* pages/chatList/chatList.wxss */
.container {
  min-height: 100vh;
  background: #f8fafd;
  padding: 0 0 32rpx 0;
}

/* 头部 */
.header {
  padding: 48rpx 32rpx 32rpx 32rpx;
  background: white;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1e2a3e;
  display: block;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 聊天列表 */
.chat-list {
  background: white;
  border-radius: 32rpx;
  margin: 0 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #f0f2f6;
  position: relative;
  transition: background 0.2s;
}

.chat-item:active {
  background: #f8fafd;
}

/* 头像区域 */
.chat-avatar {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-text {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #2266ff 0%, #6096ff 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: white;
  text-transform: uppercase;
}

.unread-dot {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  background: #ff5e5e;
  border-radius: 20rpx;
  border: 3rpx solid white;
}

/* 聊天信息 */
.chat-info {
  flex: 1;
  overflow: hidden;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.chat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e2a3e;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-time {
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.chat-preview {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.last-msg {
  font-size: 26rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
  display: block;
}

.order-tag {
  display: inline-flex;
  background: #eef2ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

.tag-text {
  font-size: 20rpx;
  color: #2266ff;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 未读数量 */
.unread-badge {
  background: #ff5e5e;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.unread-badge text {
  font-size: 22rpx;
  color: white;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  background: white;
  border-radius: 32rpx;
  margin: 120rpx 32rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e2a3e;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  margin-bottom: 48rpx;
}

.empty-btn {
  background: #2266ff;
  color: white;
  border-radius: 60rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 48rpx;
  width: auto;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #94a3b8;
}