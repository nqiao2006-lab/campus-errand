.container {
  min-height: 100vh;
  background: #f5f7fb;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 48rpx 32rpx 80rpx;
  color: white;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.form-scroll {
  margin-top: -40rpx;
  padding: 0 28rpx;
  height: calc(100vh - 280rpx);
}

.card {
  background: white;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e2a3e;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-left: 6rpx solid #667eea;
  padding-left: 20rpx;
}

.required {
  color: #ff5e5e;
}

.tag {
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  font-weight: normal;
}

.private-badge {
  background: #fff3e0;
  color: #ff9800;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  font-weight: normal;
}

/* 订单类型 */
.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 12rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.type-item.active {
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
  border-color: #667eea;
}

.type-icon {
  font-size: 44rpx;
}

.type-item text:last-child {
  font-size: 24rpx;
  color: #4a5568;
}

.type-item.active text:last-child {
  color: #667eea;
  font-weight: 500;
}

/* 文本域 */
.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 地点标签 */
.location-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.location-tag {
  padding: 12rpx 24rpx;
  background: #f8fafc;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4a5568;
}

.location-tag.active {
  background: #667eea;
  color: white;
}

.custom-input {
  width: 100%;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

/* 私密信息 */
.private-card {
  background: linear-gradient(135deg, #fffbf5 0%, #ffffff 100%);
  border: 1rpx solid #ffe0b3;
}

.private-field {
  position: relative;
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.private-input {
  width: 100%;
  padding: 24rpx 80rpx 24rpx 24rpx;
  background: #fff;
  border: 1rpx solid #ffe0b3;
  border-radius: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.lock-icon {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 32rpx;
  color: #ff9800;
}

.private-tip {
  background: #fff8e7;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.private-tip text {
  font-size: 24rpx;
  color: #e67e22;
}

/* 价格 */
.price-input-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.price-symbol {
  font-size: 44rpx;
  font-weight: 600;
  color: #ff7a2f;
}

.price-input {
  flex: 1;
  font-size: 44rpx;
  font-weight: 600;
  color: #ff7a2f;
}

.price-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.price-tag {
  padding: 12rpx 28rpx;
  background: #f8fafc;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #ff7a2f;
}

.price-tag.active {
  background: #ff7a2f;
  color: white;
}

/* 时间设置 */
.time-section {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eeeef2;
}

.time-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.time-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e2a3e;
  margin-bottom: 16rpx;
}

.time-slider-wrapper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.time-slider {
  flex: 1;
}

.time-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  min-width: 100rpx;
}

.time-desc {
  font-size: 22rpx;
  color: #999;
}

.delivery-time-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.delivery-time-tag {
  flex: 1;
  min-width: 90rpx;
  padding: 16rpx 12rpx;
  background: #f8fafc;
  border-radius: 24rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.delivery-time-tag.active {
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
  border-color: #667eea;
  color: #667eea;
  font-weight: 500;
}

.custom-time-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 20rpx;
}

.custom-time-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: white;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 1rpx solid #e5e5e5;
}

.expected-result {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #e8f5e9;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #2e7d32;
}

.warning {
  color: #ff9800;
  margin-left: 12rpx;
}

/* 订单预览 */
.summary-card {
  background: #f8fafc;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e2a3e;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e5e9f0;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #5a6e8a;
}

.price-highlight {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff7a2f;
}

.privacy-note {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #ddd;
  font-size: 24rpx;
  color: #ff9800;
}

/* 发布按钮 */
.publish-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 60rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.publish-btn[disabled] {
  background: #cbd5e1;
  box-shadow: none;
}

.bottom-space {
  height: 40rpx;
}