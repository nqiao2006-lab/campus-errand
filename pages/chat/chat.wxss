/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8fafd;
}

.chat-messages {
  flex: 1;
  padding: 32rpx;
  height: calc(100vh - 120rpx);
}

.message-row {
  display: flex;
  margin-bottom: 24rpx;
  width: 100%;
}

.message-mine {
  justify-content: flex-end;
}

.message-other {
  justify-content: flex-start;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.bubble-mine {
  background: #2266ff;
  color: white;
  border-bottom-right-radius: 8rpx;
}

.bubble-other {
  background: white;
  color: #1e2a3e;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.chat-input-area {
  background: white;
  padding: 20rpx 24rpx;
  border-top: 2rpx solid #eef2f6;
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.chat-input {
  flex: 1;
  border: 2rpx solid #eef2f6;
  border-radius: 48rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  background: #f8fafd;
}

.send-btn {
  background: #2266ff;
  border: none;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}