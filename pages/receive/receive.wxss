.container {
  min-height: 100vh;
  background: #f8fafd;
  padding: 32rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1e2a3e;
  margin-bottom: 32rpx;
}

.order-card {
  background: white;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f2f6;
}

.publisher {
  font-size: 28rpx;
  color: #2266ff;
  font-weight: 500;
}

.price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff7a2f;
}

.order-desc {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e2a3e;
  margin-bottom: 16rpx;
}

.order-location {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.order-remark {
  font-size: 24rpx;
  color: #f59e0b;
  margin-bottom: 24rpx;
  padding: 12rpx;
  background: #fef3c7;
  border-radius: 16rpx;
}

.take-btn {
  background: linear-gradient(135deg, #2266ff, #6096ff);
  color: white;
  border: none;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx;
  margin-top: 16rpx;
  width: 100%;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: #2266ff;
  color: white;
  border: none;
  border-radius: 60rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  width: auto;
  display: inline-block;
}