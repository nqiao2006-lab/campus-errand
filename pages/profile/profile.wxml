<!-- pages/profile/profile.wxml -->
<view class="container">
  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-header">
      <view class="avatar">{{userInfo.avatar}}</view>
      <view class="user-name">
        <text class="nickname">{{userInfo.nickname}}</text>
        <view class="verify-badge">
          <text class="verify-icon">✓</text>
          <text class="verify-text">已认证</text>
        </view>
      </view>
    </view>
    
    <!-- 统计数据 -->
    <view class="stats-row">
      <view class="stat-cell">
        <text class="stat-num">{{userInfo.publishedOrders || 0}}</text>
        <text class="stat-label">发布订单</text>
      </view>
      <view class="stat-cell">
        <text class="stat-num">{{userInfo.completedOrders || 0}}</text>
        <text class="stat-label">完成订单</text>
      </view>
      <view class="stat-cell">
        <text class="stat-num">{{userInfo.credit || 100}}</text>
        <text class="stat-label">信用分</text>
      </view>
    </view>
  </view>

  <!-- 聊天记录入口 -->
  <view class="menu-card" bindtap="goToChatList">
    <view class="menu-item">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-title">聊天记录</text>
      </view>
      <view class="menu-right">
        <text class="unread-badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 个人信息（隐私保护） -->
  <view class="info-card">
    <view class="info-title">
      <text class="title-icon">🔒</text>
      <text class="title-text">个人信息（仅自己可见）</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">昵称</text>
      <text class="info-value">{{userInfo.nickname}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">手机号</text>
      <text class="info-value">{{userInfo.phone || '未绑定'}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">学号</text>
      <text class="info-value">{{userInfo.studentId || '未绑定'}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">注册时间</text>
      <text class="info-value">{{userInfo.joinDate || '未知'}}</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="showStudentPhoto">
      <view class="menu-left">
        <text class="menu-icon">🎓</text>
        <text class="menu-title">学生证照片</text>
      </view>
      <text class="arrow">›</text>
    </view>
    
    <view class="menu-divider"></view>
    
    <view class="menu-item" bindtap="showAgreement">
      <view class="menu-left">
        <text class="menu-icon">📄</text>
        <text class="menu-title">用户协议</text>
      </view>
      <text class="arrow">›</text>
    </view>
    
    <view class="menu-divider"></view>
    
    <view class="menu-item" bindtap="showPrivacy">
      <view class="menu-left">
        <text class="menu-icon">🔐</text>
        <text class="menu-title">隐私政策</text>
      </view>
      <text class="arrow">›</text>
    </view>
    
    <view class="menu-divider"></view>
    
    <view class="menu-item" bindtap="clearCache">
      <view class="menu-left">
        <text class="menu-icon">🗑️</text>
        <text class="menu-title">清除缓存</text>
      </view>
      <text class="menu-value">{{cacheSize}}</text>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <button class="logout-btn" bindtap="logout">退出登录</button>
  
  <!-- 版本信息 -->
  <view class="version">荔园帮帮 v1.0.0</view>
</view>