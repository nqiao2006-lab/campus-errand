/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: #f8fafd;
  padding: 32rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #2266ff 0%, #6096ff 100%);
  border-radius: 48rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  color: white;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 600;
  backdrop-filter: blur(10px);
}

.user-name {
  flex: 1;
}

.nickname {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.verify-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 60rpx;
  font-size: 24rpx;
}

.verify-icon {
  font-size: 24rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-cell {
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 卡片菜单 */
.menu-card {
  background: white;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: white;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #1e2a3e;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.unread-badge {
  background: #ff5e5e;
  color: white;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 40rpx;
  min-width: 36rpx;
  text-align: center;
}

.arrow {
  font-size: 36rpx;
  color: #cbd5e1;
}

.menu-divider {
  height: 2rpx;
  background: #f0f2f6;
  margin: 0 32rpx;
}

.menu-value {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 信息卡片 */
.info-card {
  background: white;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.info-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f2f6;
}

.title-icon {
  font-size: 32rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e2a3e;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #64748b;
}

.info-value {
  font-size: 28rpx;
  color: #1e2a3e;
  font-weight: 500;
}

/* 退出按钮 */
.logout-btn {
  background: #fff5f5;
  color: #ff5e5e;
  border: 2rpx solid #ffe0e0;
  border-radius: 60rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx;
  margin-top: 16rpx;
  margin-bottom: 32rpx;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 32rpx;
}