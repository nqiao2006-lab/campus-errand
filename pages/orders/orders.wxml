<view class="container">
  <!-- Tab切换栏 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 'myOrders' ? 'active' : ''}}" bindtap="switchTab" data-tab="myOrders">
      我发布的
    </view>
    <view class="tab-item {{activeTab === 'myTaken' ? 'active' : ''}}" bindtap="switchTab" data-tab="myTaken">
      我接的
    </view>
  </view>

  <!-- 我发布的订单 -->
  <view wx:if="{{activeTab === 'myOrders'}}">
    <block wx:for="{{myOrders}}" wx:key="id">
      <view class="order-card">
        <view class="order-header">
          <text class="order-desc">{{item.description}}</text>
          <text class="status {{item.status}}">
            {{item.status === 'waiting' ? '等待接单' : (item.status === 'accepted' ? '已被接单' : '已取消')}}
          </text>
        </view>
        
        <view class="order-info">
          <text>📍 {{item.location}}</text>
          <text class="price">¥{{item.price}}</text>
        </view>
        
        <view class="order-remark" wx:if="{{item.remark}}">
          <text>📝 备注：{{item.remark}}</text>
        </view>
        
        <!-- 已被接单时，显示接单人信息和聊天按钮 -->
        <view wx:if="{{item.status === 'accepted' && item.takerNickname}}" class="contact-section">
          <view class="contact-info">
            <text>👤 接单人：{{item.takerNickname}}</text>
          </view>
          <button class="chat-btn" bindtap="contactUser" data-order="{{item}}">
            💬 联系接单人
          </button>
        </view>
        
        <view class="order-footer" wx:if="{{item.status === 'waiting'}}">
          <button class="cancel-btn" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view wx:if="{{myOrders.length === 0}}" class="empty-state">
      <text class="empty-text">暂无发布的订单</text>
      <button class="empty-btn" bindtap="goToPlace">去发布订单</button>
    </view>
  </view>

  <!-- 我接的订单 -->
  <view wx:if="{{activeTab === 'myTaken'}}">
    <block wx:for="{{myTaken}}" wx:key="id">
      <view class="order-card">
        <view class="order-header">
          <text class="order-desc">{{item.description}}</text>
          <text class="status accepted">进行中</text>
        </view>
        
        <view class="order-info">
          <text>📍 {{item.location}}</text>
          <text class="price">¥{{item.price}}</text>
        </view>
        
        <view class="order-remark" wx:if="{{item.remark}}">
          <text>📝 备注：{{item.remark}}</text>
        </view>
        
        <!-- 显示发布者信息和聊天按钮 -->
        <view class="contact-section">
          <view class="contact-info">
            <text>👤 发布者：{{item.creatorNickname}}</text>
          </view>
          <button class="chat-btn" bindtap="contactUser" data-order="{{item}}">
            💬 联系发布者
          </button>
        </view>
        
        <view class="order-footer">
          <button class="complete-btn" bindtap="completeOrder" data-id="{{item.id}}">完成订单</button>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view wx:if="{{myTaken.length === 0}}" class="empty-state">
      <text class="empty-text">暂无接单记录</text>
      <button class="empty-btn" bindtap="goToReceive">去接单广场</button>
    </view>
  </view>
</view>